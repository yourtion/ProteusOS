{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["files", "totals"],
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "lines", "words", "headings"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "lines": { "type": "integer", "minimum": 0 },
          "words": { "type": "integer", "minimum": 0 },
          "headings": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["files", "bytes", "lines", "words", "headings"],
      "additionalProperties": false,
      "properties": {
        "files": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "lines": { "type": "integer", "minimum": 0 },
        "words": { "type": "integer", "minimum": 0 },
        "headings": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
