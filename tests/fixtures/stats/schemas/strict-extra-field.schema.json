{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["files", "totals", "summary"],
  "additionalProperties": false,
  "properties": {
    "files": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "totals": { "type": "object" },
    "summary": { "type": "string", "minLength": 1 }
  }
}
