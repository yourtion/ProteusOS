{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "@rsbuild/core/types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "rsbuild.config.ts"
  ]
}
