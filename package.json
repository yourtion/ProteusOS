{
  "name": "@techs/proteus",
  "version": "0.1.0",
  "private": true,
  "description": "ProteusOS 运行基质：长期个体、可继承产物与受控行为变化",
  "license": "Apache-2.0",
  "bin": {
    "proteus": "bin/proteus.mjs"
  },
  "type": "module",
  "scripts": {
    "proteus": "tsx src/app/cli.ts",
    "check": "node scripts/check-boundaries.mjs && oxlint . && oxfmt --check src experiments tests bin scripts web/src web/rsbuild.config.ts && tsc --noEmit && tsc -p web/tsconfig.json && vitest run && pnpm web:build",
    "lint": "oxlint .",
    "format": "oxfmt src experiments tests bin scripts web/src web/rsbuild.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "web:build": "cd web && rsbuild build",
    "web": "tsx src/app/cli.ts web",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "experiment": "tsx experiments/cli.ts",
    "evidence:verify": "tsx scripts/verify-archives.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.79.0",
    "@agentclientprotocol/codex-acp": "^1.12.0",
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/sdk": "^0.127.0",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@hono/node-server": "^2.1.5",
    "commander": "^15.0.0",
    "hono": "^4.13.14",
    "pino": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "marked": "18.0.5"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.14",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
