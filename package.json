{
  "name": "@techs/proteus",
  "version": "0.1.0",
  "private": true,
  "description": "ProteusOS 运行基质：长期个体、可继承产物与受控行为变化",
  "license": "Apache-2.0",
  "bin": {
    "proteus": "bin/proteus.mjs"
  },
  "type": "module",
  "scripts": {
    "proteus": "tsx src/app/cli.ts",
    "check": "oxlint . && oxfmt --check src tests bin && tsc --noEmit && vitest run",
